const fs = require("fs");
const path = require("path");

module.exports.config = {
    name: "language",
    version: "1.0.0",
    hasPermssion: 2,
    credits: "مݛاسۧۛيݪٰ",
    description: "Change bot language for thread",
    commandCategory: "System",
    usages: "[ar/en]",
    cooldowns: 5
};

module.exports.run = async ({ api, event, args, Threads }) => {
    const { threadID, messageID } = event;
    const threadData = global.client.threadData.get(threadID) || {};
    const lang = args[0];
    if(lang !== "ar" && lang !== "en") return api.sendMessage("Syntax error, use: language [ar/en]", threadID, messageID);
    threadData.language = lang;
    global.client.threadData.set(threadID, threadData);
    const msg = lang === "ar" ? `تم تغيير لغة البوت إلى العربية 🟢` : `Bot language changed to English 🟢`;
    api.sendMessage(msg, threadID, messageID);
};

module.exports.get = function(threadID) {
    const config = global.config;
    let langCode = "en";
    if(config.language === "multi") {
        const threadData = global.client.threadData.get(threadID) || {};
        langCode = threadData.language || "ar";
    } else {
        langCode = config.language;
    }
    const langFile = path.join(__dirname, "languages", `${langCode}.lang`);
    if(fs.existsSync(langFile)) return JSON.parse(fs.readFileSync(langFile));
    return {};
};

module.exports.set = function(threadID, lang) {
    if(lang !== "ar" && lang !== "en") return false;
    const threadData = global.client.threadData.get(threadID) || {};
    threadData.language = lang;
    global.client.threadData.set(threadID, threadData);
    return true;
};

global.config.language = "multi";
global.config.BOTNAME = "Rizzu";
global.config.ADMINBOT = ["100000555481981"];
